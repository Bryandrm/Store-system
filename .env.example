# Copy to .env on the server and fill in. .env is gitignored.
#
#   cp .env.example .env && chmod 600 .env
#
# Generate each password with:  openssl rand -base64 32

# The migrator role. Owns the schema and runs migrations. Never used at runtime
# by the application.
POSTGRES_PASSWORD=

# The application role. Holds SELECT and INSERT, and is explicitly denied UPDATE
# and DELETE on every transactional table — which is what makes the append-only
# design a guarantee rather than a convention.
#
# The migration creates this role NOLOGIN on purpose, so no secret lives in the
# repository. After the first `docker compose up`, grant it credentials once:
#
#   docker compose exec postgres psql -U store_migrator -d store_system \
#     -c "ALTER ROLE store_app LOGIN PASSWORD '<the value below>'"
STORE_APP_PASSWORD=

# Where the API answers. Needs an A record pointing at this machine before Caddy
# can obtain a certificate.
API_DOMAIN=api.example.com

# Exact origin the PWA is served from. Never "*": the API and the frontend live
# on different hosts by design, and a wildcard would let any page call this API
# with a user's token.
ALLOWED_ORIGINS=https://tienda.example.com

# Published image. Overridden by the deploy workflow to pin a specific commit.
API_IMAGE=ghcr.io/bryandrm/store-system:latest
