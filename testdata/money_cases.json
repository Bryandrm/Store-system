{
  "_comment": [
    "Fixture SHARED between internal/money/money_test.go and src/domain/money.test.ts.",
    "It is the only thing preventing the client from quoting the buyer one total",
    "while the server stores another. If you add a case, run both suites.",
    "See docs/TESTING.md and ADR-006."
  ],

  "round_half_up": [
    { "name": "zero",                        "numer": 0,     "denom": 1000, "want": 0 },
    { "name": "smallest remainder rounds down", "numer": 1,  "denom": 1000, "want": 0 },
    { "name": "just below the tie",          "numer": 499,   "denom": 1000, "want": 0 },
    { "name": "exact tie rounds up",         "numer": 500,   "denom": 1000, "want": 1 },
    { "name": "just above the tie",          "numer": 501,   "denom": 1000, "want": 1 },
    { "name": "exact division",              "numer": 1000,  "denom": 1000, "want": 1 },
    { "name": "1.499 rounds down",           "numer": 1499,  "denom": 1000, "want": 1 },
    { "name": "1.5 rounds up",               "numer": 1500,  "denom": 1000, "want": 2 },
    { "name": "2.5 rounds up (NOT half-even)", "numer": 2500, "denom": 1000, "want": 3 },
    { "name": "3.5 rounds up",               "numer": 3500,  "denom": 1000, "want": 4 },
    { "name": "odd denominator, tie",        "numer": 5,     "denom": 10,   "want": 1 },
    { "name": "odd denominator, rounds down", "numer": 4,    "denom": 10,   "want": 0 },
    { "name": "denominator of 1 is identity", "numer": 12345, "denom": 1,   "want": 12345 }
  ],

  "line_total": [
    { "name": "one 0.25 bag",                "unit_price_cents": 25,  "qty_milli": 1000,  "want": 25 },
    { "name": "two 0.25 bags",               "unit_price_cents": 25,  "qty_milli": 2000,  "want": 50 },
    { "name": "ten 0.25 bags",               "unit_price_cents": 25,  "qty_milli": 10000, "want": 250 },
    { "name": "half a bag rounds up",        "unit_price_cents": 25,  "qty_milli": 500,   "want": 13 },
    { "name": "one and a half bags rounds up", "unit_price_cents": 25, "qty_milli": 1500, "want": 38 },
    { "name": "three at 0.50",               "unit_price_cents": 50,  "qty_milli": 3000,  "want": 150 },
    { "name": "1.00 price times 1.5",        "unit_price_cents": 100, "qty_milli": 1500,  "want": 150 },
    { "name": "negligible quantity yields zero", "unit_price_cents": 1, "qty_milli": 1,   "want": 0 },
    { "name": "zero price",                  "unit_price_cents": 0,   "qty_milli": 5000,  "want": 0 },
    { "name": "zero quantity",               "unit_price_cents": 25,  "qty_milli": 0,     "want": 0 },
    { "name": "tiny remainder rounds down",  "unit_price_cents": 999, "qty_milli": 999,   "want": 998 },
    { "name": "large sale",                  "unit_price_cents": 350, "qty_milli": 24000, "want": 8400 }
  ],

  "allocate_payment": [
    {
      "name": "covers the first debt and part of the second",
      "payment_cents": 500,
      "debts": [
        { "ref_id": "sale-a", "amount_cents": 300 },
        { "ref_id": "sale-b", "amount_cents": 400 }
      ],
      "want_allocations": [
        { "ref_id": "sale-a", "amount_cents": 300 },
        { "ref_id": "sale-b", "amount_cents": 200 }
      ],
      "want_credit_cents": 0
    },
    {
      "name": "overpayment leaves a credit balance",
      "payment_cents": 1000,
      "debts": [
        { "ref_id": "sale-a", "amount_cents": 300 },
        { "ref_id": "sale-b", "amount_cents": 400 }
      ],
      "want_allocations": [
        { "ref_id": "sale-a", "amount_cents": 300 },
        { "ref_id": "sale-b", "amount_cents": 400 }
      ],
      "want_credit_cents": 300
    },
    {
      "name": "with no debts the whole payment is credit",
      "payment_cents": 100,
      "debts": [],
      "want_allocations": [],
      "want_credit_cents": 100
    },
    {
      "name": "a zero payment touches nothing",
      "payment_cents": 0,
      "debts": [{ "ref_id": "sale-a", "amount_cents": 500 }],
      "want_allocations": [],
      "want_credit_cents": 0
    },
    {
      "name": "cancels exactly one debt",
      "payment_cents": 250,
      "debts": [{ "ref_id": "sale-a", "amount_cents": 250 }],
      "want_allocations": [{ "ref_id": "sale-a", "amount_cents": 250 }],
      "want_credit_cents": 0
    },
    {
      "name": "a single cent goes to the oldest debt",
      "payment_cents": 1,
      "debts": [
        { "ref_id": "sale-a", "amount_cents": 3 },
        { "ref_id": "sale-b", "amount_cents": 5 }
      ],
      "want_allocations": [{ "ref_id": "sale-a", "amount_cents": 1 }],
      "want_credit_cents": 0
    },
    {
      "name": "skips debts already at zero",
      "payment_cents": 200,
      "debts": [
        { "ref_id": "sale-a", "amount_cents": 0 },
        { "ref_id": "sale-b", "amount_cents": 150 },
        { "ref_id": "sale-c", "amount_cents": 100 }
      ],
      "want_allocations": [
        { "ref_id": "sale-b", "amount_cents": 150 },
        { "ref_id": "sale-c", "amount_cents": 50 }
      ],
      "want_credit_cents": 0
    }
  ]
}
